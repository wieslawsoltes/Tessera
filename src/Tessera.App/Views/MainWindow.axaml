<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Tessera.Views.MainWindow" Title="Tessera" Width="1600" Height="1000" MinWidth="720" MinHeight="500" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="-1" WindowStartupLocation="CenterScreen">
 <Grid x:Name="Root" RowDefinitions="55,*">
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
   <Grid x:Name="TitleBand" WindowDecorationProperties.ElementRole="TitleBar" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="16,0,16,0">
    <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center" Margin="0,0,20,0">
     <Canvas Width="22" Height="22"><Border Width="7" Height="19" Background="{DynamicResource Accent}" CornerRadius="1" Canvas.Top="2"/><Border Width="7" Height="7" Background="{DynamicResource Accent}" CornerRadius="1" Canvas.Left="11" Canvas.Top="2"/><Border Width="7" Height="9" Background="{DynamicResource Accent}" CornerRadius="1" Canvas.Left="11" Canvas.Top="12"/></Canvas>
     <TextBlock Text="tessera" FontSize="22" FontWeight="SemiBold" LetterSpacing="-0.8"/>
     <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4" Padding="6,3" VerticalAlignment="Center"><TextBlock Text="ALPHA 01" FontSize="8" LetterSpacing="1.3" Classes="faint"/></Border>
    </StackPanel>
    <Menu x:Name="MainMenu" WindowDecorationProperties.ElementRole="User" Grid.Column="1" VerticalAlignment="Center"/>
    <Button x:Name="PaletteButton" WindowDecorationProperties.ElementRole="User" Grid.Column="3" Width="360" Height="32" BorderBrush="{DynamicResource Line}" BorderThickness="1" HorizontalContentAlignment="Stretch" Margin="0,0,16,0"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="⌕  Find a command, session, or workspace…" FontSize="11" Classes="faint"/><TextBlock Grid.Column="1" Text="⌘ K" FontSize="10" Classes="muted"/></Grid></Button>
    <Button x:Name="ThemeButton" WindowDecorationProperties.ElementRole="User" Grid.Column="4" Classes="icon" Margin="0,0,20,0" ToolTip.Tip="Change theme"/>
    <Border Grid.Column="5" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentWash}" VerticalAlignment="Center"><TextBlock x:Name="Avatar" Text="WS" FontSize="10" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/></Border>
   </Grid>
  </Border>
  <Grid Grid.Row="1" ColumnDefinitions="52,226,*" x:Name="ShellGrid">
   <Border x:Name="Rail" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0"><DockPanel Margin="0,14,0,10"><StackPanel x:Name="RailBottom" DockPanel.Dock="Bottom" Spacing="12" HorizontalAlignment="Center"/><StackPanel x:Name="RailTop" Spacing="11" HorizontalAlignment="Center"/></DockPanel></Border>
   <Border x:Name="Sidebar" Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0"><DockPanel Margin="12,16,12,0"><StackPanel DockPanel.Dock="Bottom" Margin="10,30,10,26" Spacing="12"><TextBlock Text="EVERYTHING IN ITS PLACE" Classes="eyebrow" FontSize="8"/><TextBlock Text="Your sessions.&#xA;Your way of working." FontSize="18" LineHeight="25" TextWrapping="Wrap" Classes="muted"/><Button x:Name="ExploreButton" Content="Explore Tessera       ↗" FontSize="11" HorizontalAlignment="Left" Padding="0"/></StackPanel><ScrollViewer><StackPanel x:Name="SideContent" Spacing="3"/></ScrollViewer></DockPanel></Border>
   <Grid Grid.Column="2" RowDefinitions="81,35,*,28" x:Name="MainGrid">
    <Grid x:Name="WorkspaceHeader" ColumnDefinitions="*,Auto" Margin="24,0">
     <StackPanel Orientation="Horizontal" Spacing="13" VerticalAlignment="Center"><Border Width="36" Height="36" Background="{DynamicResource AccentWash}" CornerRadius="10"><TextBlock x:Name="WorkspaceSigil" Text="D" FontSize="17" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/></Border><StackPanel Spacing="4" VerticalAlignment="Center"><TextBlock x:Name="WorkspaceTitle" Text="Development" Classes="heading"/><TextBlock x:Name="WorkspaceDescription" Text="Build, test, and ship in one place." FontSize="11" Classes="faint"/></StackPanel></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" x:Name="WorkspaceActions"/>
    </Grid>
    <Border Grid.Row="1" x:Name="ContextBorder" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1"><Grid ColumnDefinitions="*,Auto" Margin="23,0,12,0"><StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"><TextBlock Text="•" Foreground="{DynamicResource Accent}"/><TextBlock x:Name="SessionCount" Text="1 session" FontSize="11" Classes="faint"/><TextBlock Text="/" Classes="faint"/><TextBlock x:Name="WorkingDirectoryText" FontSize="10" Classes="faint"/></StackPanel><StackPanel x:Name="ContextActions" Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"/></Grid></Border>
    <Grid Grid.Row="2" x:Name="ContentGrid" RowDefinitions="*,4,184" ColumnDefinitions="*">
     <ContentControl x:Name="DockSurface" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
     <GridSplitter x:Name="ToolsSplitter" Grid.Row="1" Height="4" HorizontalAlignment="Stretch" ResizeDirection="Rows"/>
     <Border x:Name="ToolsBorder" Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"><Grid RowDefinitions="38,*"><Grid ColumnDefinitions="*,Auto" Margin="17,0,12,0"><StackPanel x:Name="ToolTabs" Orientation="Horizontal" Spacing="4"/><StackPanel x:Name="ToolActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"/></Grid><ScrollViewer Grid.Row="1" x:Name="ToolScroll" Padding="22,12,22,14"><ContentControl x:Name="ToolContent" HorizontalContentAlignment="Stretch"/></ScrollViewer></Grid></Border>
    </Grid>
    <Border Grid.Row="3" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"><Grid ColumnDefinitions="*,Auto" Margin="12,0"><TextBlock x:Name="Status" Text="Ready" FontSize="9" Classes="muted" TextTrimming="CharacterEllipsis"/><StackPanel x:Name="StatusActions" Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"/></Grid></Border>
   </Grid>
  </Grid>
  <Border x:Name="OverlayShade" Grid.RowSpan="2" Background="#99080b09" IsVisible="False" ZIndex="100"><Border x:Name="OverlayPanel" MaxWidth="920" MaxHeight="720" Margin="30" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" BoxShadow="0 24 80 0 #80000000"><ContentControl x:Name="OverlayContent" HorizontalContentAlignment="Stretch"/></Border></Border>
 </Grid>
</Window>
